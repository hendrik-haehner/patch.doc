# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

PORT=3000
DATA_DIR=/data

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated username:password pairs. First user becomes admin.
PATCHDOC_USERS=admin:changeme
