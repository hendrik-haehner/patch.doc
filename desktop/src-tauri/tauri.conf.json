{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PATCH.doc",
  "version": "1.0.0",
  "identifier": "com.patchdoc.app",
  "build": {
    "beforeDevCommand": "node ../scripts/build-static.js",
    "beforeBuildCommand": "node ../scripts/build-static.js",
    "frontendDist": "../../_site"
  },
  "app": {
    "windows": [
      {
        "title": "PATCH.doc",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
